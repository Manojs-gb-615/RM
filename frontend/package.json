{
  "name": "contextsign-avatar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Three.js ASL avatar renderer for ContextSign AI (vanilla TypeScript core + demo viewer)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx eval/eval.ts",
    "golden": "tsx eval/eval.ts --write-golden"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.187.0",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  }
}
